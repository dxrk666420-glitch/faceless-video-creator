# Required
DATABASE_URL=sqlite:///./faceless.db

# Optional - app works without these using free alternatives
ELEVENLABS_API_KEY=           # Premium TTS (falls back to edge-tts)
OPENAI_API_KEY=               # Required for Sora feature only
PEXELS_API_KEY=               # Required for background videos
REDDIT_CLIENT_ID=             # Required for Reddit feature
REDDIT_CLIENT_SECRET=         # Required for Reddit feature
REDDIT_USER_AGENT=FacelessVideoCreator/1.0
