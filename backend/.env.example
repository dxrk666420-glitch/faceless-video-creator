# Database (SQLite fallback if Supabase not set)
DATABASE_URL=sqlite:///./faceless.db

# Supabase (recommended - set these to use PostgreSQL)
SUPABASE_URL=                 # e.g. https://xxxx.supabase.co
SUPABASE_KEY=                 # anon or service_role key
SUPABASE_DB_URL=              # postgresql://postgres:[password]@db.xxxx.supabase.co:5432/postgres

# AI Story Generation (OpenRouter)
OPENROUTER_API_KEY=           # Get free key at openrouter.ai

# Optional - app works without these using free alternatives
ELEVENLABS_API_KEY=           # Premium TTS (falls back to edge-tts)
OPENAI_API_KEY=               # Required for Sora feature only
PEXELS_API_KEY=               # Required for background videos
REDDIT_CLIENT_ID=             # Required for Reddit browse feature
REDDIT_CLIENT_SECRET=         # Required for Reddit browse feature
REDDIT_USER_AGENT=FacelessVideoCreator/1.0
